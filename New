/* ================= ADMIN PRODUCTS ================= */

app.post("/api/admin/products", auth, (req, res) => {
  const products = readJSON(DATA);
  const body = req.body;

  if (
    !body.name ||
    body.price === undefined ||
    !body.category
  ) {
    return res.status(400).json({
      error: "Name, price and category are required"
    });
  }

  const item = {
    id: "p" + Date.now(),
    name: String(body.name),
    price: Number(body.price),
    category: String(body.category),
    gender: String(body.gender || "Unisex"),
    sizes: Array.isArray(body.sizes) ? body.sizes : [],
    stock: Math.max(0, Number(body.stock || 0)),
    image: String(body.image || ""),
    description: String(body.description || "")
  };

  products.push(item);
  writeJSON(DATA, products);

  res.json(item);
});

app.put("/api/admin/products/:id", auth, (req, res) => {
  const products = readJSON(DATA);

  const index = products.findIndex(
    x => x.id === req.params.id
  );

  if (index < 0) {
    return res.status(404).json({
      error: "Product not found"
    });
  }

  products[index] = {
    ...products[index],
    ...req.body,
    id: products[index].id,
    price: Number(
      req.body.price ?? products[index].price
    ),
    stock: Math.max(
      0,
      Number(req.body.stock ?? products[index].stock)
    )
  };

  writeJSON(DATA, products);

  res.json(products[index]);
});

app.delete("/api/admin/products/:id", auth, (req, res) => {
  const products = readJSON(DATA).filter(
    x => x.id !== req.params.id
  );

  writeJSON(DATA, products);

  res.json({ ok: true });
});

/* ================= ADMIN ORDERS ================= */

app.get("/api/admin/orders", auth, (req, res) => {
  res.json(readJSON(ORDERS));
});

app.patch("/api/admin/orders/:id", auth, (req, res) => {
  const allowed = [
    "NEW",
    "CONFIRMED",
    "PACKED",
    "SHIPPED",
    "DELIVERED",
    "CANCELLED",
    "PAID",
    "COD — Order Placed",
    "PAYMENT_PENDING"
  ];

  const orders = readJSON(ORDERS);

  const index = orders.findIndex(
    x => x.id === req.params.id
  );

  if (index < 0) {
    return res.status(404).json({
      error: "Order not found"
    });
  }

  const status = String(
    req.body.status || ""
  );

  if (!allowed.includes(status)) {
    return res.status(400).json({
      error: "Invalid order status"
    });
  }

  orders[index].status = status;

  writeJSON(ORDERS, orders);

  res.json(orders[index]);
});

/* ================= ADMIN COUPONS ================= */

app.post("/api/admin/coupons", auth, (req, res) => {
  const coupons = readJSON(COUPONS);
  const body = req.body;

  const code = String(
    body.code || ""
  ).trim().toUpperCase();

  if (
    !code ||
    !body.type ||
    body.value === undefined
  ) {
    return res.status(400).json({
      error: "Code, type and value are required"
    });
  }

  if (!["percent", "flat"].includes(body.type)) {
    return res.status(400).json({
      error: "Type must be percent or flat"
    });
  }

  const value = Number(body.value);

  if (value <= 0) {
    return res.status(400).json({
      error: "Discount value must be greater than 0"
    });
  }

  if (
    body.type === "percent" &&
    value > 100
  ) {
    return res.status(400).json({
      error: "Percentage cannot exceed 100"
    });
  }

  if (
    coupons.some(x => x.code === code)
  ) {
    return res.status(409).json({
      error: "Coupon already exists"
    });
  }

  const coupon = {
    id: "c" + Date.now(),
    code,
    type: body.type,
    value,
    active: body.active !== false,
    minOrder: Number(body.minOrder || 0),
    maxDiscount: Number(body.maxDiscount || 0)
  };

  coupons.push(coupon);

  writeJSON(COUPONS, coupons);

  res.json(coupon);
});

app.delete("/api/admin/coupons/:id", auth, (req, res) => {
  const coupons = readJSON(COUPONS).filter(
    x => x.id !== req.params.id
  );

  writeJSON(COUPONS, coupons);

  res.json({ ok: true });
});

/* ================= RAZORPAY ================= */

function razorpay() {
  if (
    !process.env.RAZORPAY_KEY_ID ||
    !process.env.RAZORPAY_KEY_SECRET
  ) {
    return null;
  }

  return new Razorpay({
    key_id: process.env.RAZORPAY_KEY_ID,
    key_secret: process.env.RAZORPAY_KEY_SECRET
  });
}

/* ================= COUPON CALCULATION ================= */

function calculateCoupon(code, subtotal) {
  if (!code) {
    return {
      discount: 0
    };
  }

  const coupons = readJSON(COUPONS);

  const coupon = coupons.find(
    x =>
      x.code === String(code)
        .trim()
        .toUpperCase() &&
      x.active
  );

  if (!coupon) {
    return {
      error: "Invalid or inactive coupon"
    };
  }

  if (subtotal < coupon.minOrder) {
    return {
      error:
        "Minimum order for this coupon is ₹" +
        coupon.minOrder
    };
  }

  let discount =
    coupon.type === "percent"
      ? subtotal * coupon.value / 100
      : coupon.value;

  if (coupon.maxDiscount > 0) {
    discount = Math.min(
      discount,
      coupon.maxDiscount
    );
  }

  discount = Math.min(
    discount,
    subtotal
  );

  return {
    discount: Math.round(discount),
    coupon: coupon.code
  };
}

/* ================= CREATE ORDER ================= */

app.post("/api/create-order", async (req, res) => {
  try {
    const {
      items,
      customer,
      paymentMethod,
      couponCode
    } = req.body;

    if (
      !customer?.name ||
      !customer?.phone ||
      !customer?.address ||
      !customer?.city ||
      !customer?.state ||
      !customer?.pincode
    ) {
      return res.status(400).json({
        error:
          "Name, phone, address, city, state and pincode are required"
      });
    }

    if (
      !Array.isArray(items) ||
      !items.length
    ) {
      return res.status(400).json({
        error: "Cart is empty"
      });
    }

    if (
      !["cod", "online"].includes(
        paymentMethod
      )
    ) {
      return res.status(400).json({
        error: "Invalid payment method"
      });
    }

    const products = readJSON(DATA);

    let subtotal = 0;
    const cleanItems = [];

    for (const item of items) {
      const product = products.find(
        p => p.id === item.id
      );

      const qty = Math.max(
        1,
        Math.floor(Number(item.qty || 1))
      );

      if (!product) {
        return res.status(400).json({
          error: "Product not found"
        });
      }

      if (product.stock < qty) {
        return res.status(400).json({
          error:
            `Only ${product.stock} left for ${product.name}`
        });
      }

      if (
        !Array.isArray(product.sizes) ||
        !product.sizes.includes(
          String(item.size || "")
        )
      ) {
        return res.status(400).json({
          error:
            `Please select a valid size for ${product.name}`
        });
      }

      subtotal +=
        product.price * qty;

      cleanItems.push({
        id: product.id,
        name: product.name,
        price: product.price,
        qty,
        size: String(item.size)
      });
    }

    const coupon =
      calculateCoupon(
        couponCode,
        subtotal
      );

    if (coupon.error) {
      return res.status(400).json({
        error: coupon.error
      });
    }

    const discount =
      coupon.discount || 0;

    const total =
      subtotal - discount;

    const orderId =
      "SB" + Date.now();

    const orders =
      readJSON(ORDERS);

    const order = {
      id: orderId,
      items: cleanItems,
      customer,
      paymentMethod,
      coupon: coupon.coupon || "",
      discount,
      subtotal,
      total,
      status:
        paymentMethod === "cod"
          ? "COD — Order Placed"
          : "PAYMENT_PENDING",
      stockAdjusted: false,
      createdAt:
        new Date().toISOString()
    };

    /* COD */
    if (paymentMethod === "cod") {
      for (const item of cleanItems) {
        const product =
          products.find(
            p => p.id === item.id
          );

        product.stock -= item.qty;
      }

      order.stockAdjusted = true;

      writeJSON(DATA, products);

      orders.push(order);

      writeJSON(ORDERS, orders);

      return res.json({
        cod: true,
        orderId,
        total
      });
    }

    /* ONLINE PAYMENT */

    const r = razorpay();

    if (!r) {
      return res.status(503).json({
        error:
          "Online payment is not configured. Add Razorpay keys in Render."
      });
    }

    orders.push(order);
    writeJSON(ORDERS, orders);

    try {
      const razorpayOrder =
        await r.orders.create({
          amount: total * 100,
          currency: "INR",
          receipt: orderId,
          notes: {
            store: "STYLO BUYZ",
            customer_phone:
              customer.phone
          }
        });

      order.razorpayOrderId =
        razorpayOrder.id;

      orders[orders.length - 1] =
        order;

      writeJSON(
        ORDERS,
        orders
      );

      res.json({
        keyId:
          process.env.RAZORPAY_KEY_ID,
        razorpayOrderId:
          razorpayOrder.id,
        orderId,
        total
      });

    } catch (e) {
      console.error(e);

      writeJSON(
        ORDERS,
        orders.filter(
          x => x.id !== orderId
        )
      );

      res.status(500).json({
        error:
          "Could not create payment order"
      });
    }

  } catch (e) {
    console.error(e);

    res.status(500).json({
      error: "Could not create order"
    });
  }
});

/* ================= VERIFY PAYMENT ================= */

app.post("/api/verify-payment", (req, res) => {
  try {
    const {
      razorpay_order_id,
      razorpay_payment_id,
      razorpay_signature,
      orderId
    } = req.body;

    const secret =
      process.env.RAZORPAY_KEY_SECRET;

    if (!secret) {
      return res.status(503).json({
        error:
          "Payment verification is not configured"
      });
    }

    const expected =
      crypto
        .createHmac(
          "sha256",
          secret
        )
        .update(
          razorpay_order_id +
          "|" +
          razorpay_payment_id
        )
        .digest("hex");

    if (
      !razorpay_signature ||
      !crypto.timingSafeEqual(
        Buffer.from(expected),
        Buffer.from(
          String(razorpay_signature)
        )
      )
    ) {
      return res.status(400).json({
        error:
          "Payment signature verification failed"
      });
    }

    const orders =
      readJSON(ORDERS);

    const index =
      orders.findIndex(
        x =>
          x.id === orderId &&
          x.razorpayOrderId ===
            razorpay_order_id
      );

    if (index < 0) {
      return res.status(404).json({
        error: "Order not found"
      });
    }

    const order =
      orders[index];

    if (order.status !== "PAID") {
      const products =
        readJSON(DATA);

      for (const item of order.items) {
        const product =
          products.find(
            p => p.id === item.id
          );

        if (
          !product ||
          product.stock < item.qty
        ) {
          return res.status(409).json({
            error:
              `Stock changed for ${item.name}. Contact the store.`
          });
        }
      }

      for (const item of order.items) {
        const product =
          products.find(
            p => p.id === item.id
          );

        product.stock -= item.qty;
      }

      order.stockAdjusted = true;
      order.status = "PAID";
      order.razorpayPaymentId =
        razorpay_payment_id;

      writeJSON(DATA, products);
      writeJSON(ORDERS, orders);
    }

    res.json({
      ok: true,
      orderId
    });

  } catch (e) {
    console.error(e);

    res.status(500).json({
      error: "Verification failed"
    });
  }
});

/* ================= RAZORPAY WEBHOOK ================= */

app.post(
  "/api/razorpay-webhook",
  (req, res) => {
    try {
      const secret =
        process.env.RAZORPAY_WEBHOOK_SECRET;

      if (secret) {
        const signature =
          req.headers[
            "x-razorpay-signature"
          ];

        const expected =
          crypto
            .createHmac(
              "sha256",
              secret
            )
            .update(req.body)
            .digest("hex");

        if (
          !signature ||
          !crypto.timingSafeEqual(
            Buffer.from(expected),
            Buffer.from(
              String(signature)
            )
          )
        ) {
          return res
            .status(400)
            .send("bad signature");
        }
      }

      const body =
        JSON.parse(
          req.body.toString("utf8")
        );

      const event =
        body.event || "";

      if (
        event ===
          "payment.captured" &&
        body.payload?.payment?.entity
      ) {
        const payment =
          body.payload.payment.entity;

        const razorpayOrderId =
          payment.order_id;

        const orders =
          readJSON(ORDERS);

        const index =
          orders.findIndex(
            x =>
              x.razorpayOrderId ===
              razorpayOrderId
          );

        if (
          index >= 0 &&
          orders[index].status !== "PAID"
        ) {
          const products =
            readJSON(DATA);

          let enoughStock = true;

          for (
            const item
            of orders[index].items
          ) {
            const product =
              products.find(
                p => p.id === item.id
              );

            if (
              !product ||
              product.stock < item.qty
            ) {
              enoughStock = false;
            }
          }

          if (enoughStock) {
            for (
              const item
              of orders[index].items
            ) {
              const product =
                products.find(
                  p => p.id === item.id
                );

              product.stock -=
                item.qty;
            }

            writeJSON(
              DATA,
              products
            );
          }

          orders[index].stockAdjusted =
            enoughStock;

          orders[index].status =
            "PAID";

          orders[index].razorpayPaymentId =
            payment.id;

          writeJSON(
            ORDERS,
            orders
          );
        }
      }

      res.json({
        received: true
      });

    } catch (e) {
      console.error(e);

      res
        .status(400)
        .send("bad webhook");
    }
  }
);

